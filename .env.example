DATABASE_URL=postgres://book:book@localhost:55432/book?sslmode=disable
PORT=8080
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
ALLOW_DEV_AUTH=true
LOCAL_AUTH_ENABLED=true
DEV_USER_ID=11111111-1111-4111-8111-111111111111
LOG_LEVEL=info

# Supabase project Connect panel / Auth signing keys
SUPABASE_URL=
# 비우면 SUPABASE_URL에서 자동으로 계산합니다.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
# 서버에서만 사용하는 Auth 관리 키. 모바일 번들에 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# 32자 이상의 운영자 API 비밀과 HTTPS 앱/초대 링크 기준 주소
ADMIN_API_KEY=
PUBLIC_APP_URL=

# Kakao Developers > App keys > REST API key
KAKAO_REST_API_KEY=
# Google Cloud Console > APIs & Services > Credentials > API key (Books API로 제한)
GOOGLE_BOOKS_API_KEY=
EXPO_PUSH_URL=
