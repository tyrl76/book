{
	email {$ACME_EMAIL}
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	@ownerOnly path /admin /admin/* /v1/admin/* /v1/auth/register
	basic_auth @ownerOnly argon2id {
		owner {$ADMIN_BASIC_HASH}
	}

	reverse_proxy api:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}
